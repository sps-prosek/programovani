/T ( switch \(volba\)  {     case 1:        printf\("Vysledek scitani je: %.2f", x + y\);        break;     case 2:        printf\("Vysledek odcitani je: %.2f", x - y\);        break;     case 3:        printf\("Vysledek nasobeni je: %.2f", x * y\);        break;     case 4:        if \(y != 0\)           printf\("Vysledek deleni je: %.2f", x / y\);        else           printf\("Nulou nelze delit"\);        break;     default:        printf\("Spatna volba"\);  })
/E ( switch \(volba\)  {     case 1:        printf\("Vysledek scitani je: %.2f", x + y\);        break;     case 2:        printf\("Vysledek odcitani je: %.2f", x - y\);        break;     case 3:        printf\("Vysledek nasobeni je: %.2f", x * y\);        break;     case 4:        if \(y != 0\)           printf\("Vysledek deleni je: %.2f", x / y\);        else           printf\("Nulou nelze delit"\);        break;     default:        printf\("Spatna volba"\);  })
